# TargetGum AI Marketing OS - Environment Variables
# Copy to .env.local for local development. NEVER commit real secrets.
# In staging/production, these values should be injected by the secrets
# manager (see docs/SECURITY.md) - this file documents required keys only.

# --- App ---
NODE_ENV="development"
APP_ENV="local" # local | development | staging | production
APP_URL="http://localhost:3000"

# --- Database (PostgreSQL) ---
# Pooled connection string, used by the app at runtime. On Supabase this is
# the "Transaction" pooler URL (port 6543, ?pgbouncer=true); on Neon, the
# pooled endpoint. On a plain Postgres instance with no pooler, same as
# DIRECT_URL below.
DATABASE_URL="postgresql://user:password@localhost:5432/targetgum_dev"
# Direct, unpooled connection string - required by `prisma migrate`/`db
# push` (pgbouncer's transaction mode doesn't support the advisory locks
# Migrate uses). On Supabase this is the port-5432 direct connection URL.
DIRECT_URL="postgresql://user:password@localhost:5432/targetgum_dev"

# --- Auth ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Magic link email delivery (see docs/ARCHITECTURE.md Auth section)
EMAIL_FROM="no-reply@targetgum.example"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# --- Secrets / Encryption ---
# Envelope-encryption key used to encrypt OAuth refresh tokens and other
# integration secrets at rest (see docs/SECURITY.md). In production this
# key reference should point at a KMS/secrets manager entry, not a literal
# value checked into any environment file.
INTEGRATION_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# --- Claude / Anthropic (AI Gateway) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-5"

# --- Metricool MCP ---
METRICOOL_MCP_URL=""
METRICOOL_API_KEY=""

# --- Canva MCP (optional - Phase 1, graceful degrade if absent) ---
CANVA_MCP_URL=""
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""

# --- Google Analytics 4 ---
GA4_OAUTH_CLIENT_ID=""
GA4_OAUTH_CLIENT_SECRET=""

# --- Google Search Console ---
GSC_OAUTH_CLIENT_ID=""
GSC_OAUTH_CLIENT_SECRET=""

# --- Queue (Redis / BullMQ) ---
REDIS_URL="redis://localhost:6379"
# Shared secret the /api/cron/* route handlers require in an
# `Authorization: Bearer <value>` header - Vercel Cron sends this
# automatically when configured (see docs/ARCHITECTURE.md's Scheduled
# Automation section). Without it, anyone who guesses the route URL could
# trigger paid AI workflows for every opted-in client.
CRON_SECRET="replace-with-openssl-rand-base64-32"

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Observability ---
SENTRY_DSN=""
LOG_LEVEL="info"
